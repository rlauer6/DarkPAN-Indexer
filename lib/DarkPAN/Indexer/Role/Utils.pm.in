package DarkPAN::Indexer::Role::Utils;

use strict;
use warnings;

use Carp qw(croak);
use English qw(_no_match_vars);
use File::Basename qw(basename);
use File::Temp qw(tempfile);

use Role::Tiny;

#########################################################################
sub fetch_packages_version_index {
#########################################################################
  my ( $self, %args ) = @_;

  require IO::Uncompress::Gunzip;

  my ( $s3, $bucket, $packages_index ) = @args{qw(s3 bucket packages_index)};

  my $has_db = $s3->head_object( $bucket, $packages_index );

  croak sprintf "ERROR: no %s found!\n", basename($packages_index)
    if !$has_db;

  my $obj = $s3->get_object( $bucket, $packages_index );

  my $zipped_content = $obj->{content};
  my $content        = q{};

  IO::Uncompress::Gunzip::gunzip( \$zipped_content, \$content );

  my ( $fh, $database ) = tempfile( SUFFIX => '.db', UNLINK => 0, DIR => '/tmp' );

  print {$fh} $content;

  close $fh;

  return $database;
}

########################################################################
sub save_packages_version_index {
########################################################################
  my ( $self, %args ) = @_;

  my ( $database, $bucket, $s3, $packages_index ) = @args{qw(database bucket s3 packages_index)};

  require IO::Compress::Gzip;

  my $zipped_content = q{};
  my $content        = $self->_slurp($database);

  IO::Compress::Gzip::gzip( \$content, \$zipped_content );

  return $s3->put_object( $bucket, $packages_index, $zipped_content, content_type => 'application/gzip' );
}

########################################################################
sub _slurp {
########################################################################
  my ( $self, $file ) = @_;

  my $content = eval {
    local $RS = undef;

    open my $fh, '<', $file
      or croak "could not open $file for reading\n$OS_ERROR";

    binmode $fh;

    my $content = <$fh>;

    close $fh;

    return $content;
  };

  croak "ERROR: $EVAL_ERROR"
    if !$content || $EVAL_ERROR;

  return $content;
}

1;
